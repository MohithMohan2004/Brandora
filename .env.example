# Ollama runs locally: embeddings for catalogue retrieval, and the writer of last resort.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=embeddinggemma

# Cloudflare Workers AI — copy these from your Cloudflare dashboard.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
# FLUX.2 klein draws far less stray lettering than flux-1-schnell.
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-9b

# Writer models on Cloudflare Workers AI, tried in order (comma separated).
# A full brief takes ~5s here versus minutes for the local Ollama model on a CPU.
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast,@cf/meta/llama-3.1-8b-instruct-fast

# Rewrites the visual direction as a plain photo description (no words, logos, layout).
CLOUDFLARE_SCENE_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
# Checks each photo for lettering and clutter; Brandora retries up to 3 times.
CLOUDFLARE_VISION_MODEL=@cf/mistralai/mistral-small-3.1-24b-instruct
